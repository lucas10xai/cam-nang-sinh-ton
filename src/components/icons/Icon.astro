---
/* Icon nét đơn sắc (Lucide, stroke 1.6). Xem paths.ts. Mặc định 16px; nét/màu đặt ở CSS `.icon`. */
import { type IconName } from './paths';
import { url } from '../../lib/url';
interface Props { name: IconName; size?: number; class?: string; }
const { name, size = 16, class: cls } = Astro.props;
---
<svg class:list={['icon', cls]} width={size} height={size} aria-hidden="true"><use href={url(`/icons.svg#${name}`)} /></svg>
