---
import EntryChips from './EntryChips.astro';
import VerifyBadge from './VerifyBadge.astro';
import { url, entryCode, entrySummary, type Entry } from '../lib/site';
interface Props { entry: Entry; badge?: boolean; slim?: boolean; }
const { entry, badge = true, slim = false } = Astro.props;
const summary = entrySummary(entry);
---
<article class="card entry-card">
  <span class="entry-card__code" aria-hidden="true">{entryCode(entry)}</span>
  <div class="entry-card__main">
    <h3 class="entry-card__title"><a href={url.entry(entry.data.id)}><span class="visually-hidden">Mục {entryCode(entry)}: </span>{entry.data.title}</a></h3>
    {summary && <p class="entry-card__tldr">{summary}</p>}
    <div class="entry-card__meta">
      <EntryChips entry={entry} slim={slim} />
      {badge && <p class="entry-card__v"><VerifyBadge v={entry.data.verification} slim={slim} /></p>}
    </div>
  </div>
</article>
