---
// Hàng pill duy nhất dưới tiêu đề mục. Pill có mũi tên mở giải thích ngay dưới nó (<details data-pop>; Esc đóng).
import Icon from './icons/Icon.astro';
import {
  COST_LABELS, WORTH_LABELS, WORTH_NOTE, EVIDENCE_LABELS, DISCLAIMER, VERIFICATION_TONE,
  verificationLabel, verificationNote, worthOf, url, type Entry,
} from '../lib/site';
interface Props { entry: Entry; }
const d = Astro.props.entry.data;
const v = d.verification;
const worth = worthOf(d);
const tone = VERIFICATION_TONE[v.status] ?? 'none';
const note = verificationNote(v);
const vClass = tone === 'review' ? 'pill--danger' : tone === 'good' || tone === 'expert' ? 'pill--good' : 'pill--warn';
const evClass = d.evidence === 'A' ? 'pill--good' : 'pill--warn';
---
<ul class="pills" data-pagefind-ignore aria-label="Chi phí, bằng chứng, mức đáng làm và trạng thái kiểm chứng">
  <li><span class:list={['pill', { 'pill--good': d.cost.money === '0' }]}>{COST_LABELS.money[d.cost.money]}</span></li>
  <li><span class="pill">{COST_LABELS.time[d.cost.time]}</span></li>
  <li><span class="pill">{COST_LABELS.will[d.cost.will]}</span></li>
  <li>
    <details class="pop" data-pop>
      <summary class={`pill ${evClass}`}>Bằng chứng {d.evidence}<Icon name="chevron-down" size={12} /></summary>
      <div class="popover pop__panel"><p>{EVIDENCE_LABELS[d.evidence]}.</p><p><a class="link" href={url('/phuong-phap/#bc-h')}>Cách hiểu mức A, B, C</a></p></div>
    </details>
  </li>
  <li>
    <details class="pop" data-pop>
      <summary class="pill">Đáng làm: {WORTH_LABELS[worth].toLowerCase()}<Icon name="chevron-down" size={12} /></summary>
      <div class="popover pop__panel"><p><strong>{WORTH_NOTE}</strong> Mức này tính từ lợi ích và ba loại chi phí (tiền, thời gian, ý chí), không phải từ bằng chứng.</p><p><a class="link" href={url('/phuong-phap/#dl-h')}>Xem cách tính</a></p></div>
    </details>
  </li>
  {d.contested && <li><span class="pill pill--warn">Còn tranh luận</span></li>}
  <li>
    <details class="pop" data-pop>
      <summary class={`pill ${vClass}`}>{verificationLabel(v)}<Icon name="chevron-down" size={12} /></summary>
      <div class="popover pop__panel pop__panel--wide">
        {note.lead && <p><strong>{note.lead}</strong></p>}
        <p>{note.text}</p>
        {v.status !== 'expert-reviewed' && <p>{DISCLAIMER}</p>}
        {v.sources.length > 0 && <p>Đã đối chiếu: {v.sources.length} nguồn.</p>}
        {d.contested && <p><strong>Mục này có điểm còn tranh luận</strong>, xem phần Ghi chú.</p>}
        <p><a class="link" href={url('/phuong-phap/')}>Cách chúng tôi kiểm chứng</a></p>
      </div>
    </details>
  </li>
</ul>
