---
import Icon from './icons/Icon.astro';
import { VERIFICATION_TONE, verificationLabel, verificationNote, type Entry } from '../lib/site';
interface Props { v: Entry['data']['verification']; slim?: boolean; /** "tag": huy hiệu đặc; mặc định: dòng trạng thái nhẹ cho danh sách */ variant?: 'line' | 'tag'; }
const { v, slim = false, variant = 'line' } = Astro.props;
const note = verificationNote(v);
const tip = [note.lead, note.text].filter(Boolean).join(' ');
const tone = VERIFICATION_TONE[v.status] ?? 'none';
const icon = tone === 'none' ? 'alert-triangle' : tone === 'review' ? 'shield-alert' : 'shield-check';
// Trong danh sách, "đang rà soát" vẫn là huy hiệu đặc (quan trọng); các trạng thái khác là dòng nhẹ có chấm màu.
const solid = variant === 'tag' || tone === 'review';
---
{solid
  ? <span class={`badge badge--${tone}`} title={tip}>{!slim && <Icon name={icon} size={14} />}{verificationLabel(v)}</span>
  : <span class={`vstat vstat--${tone}`} title={tip}><i class="vstat__dot" aria-hidden="true"></i>{verificationLabel(v)}</span>}
