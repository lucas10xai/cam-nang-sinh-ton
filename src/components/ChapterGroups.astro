---
// Chương gom theo nhóm chủ đề (data/chapter-groups.json), kèm số mục và tiến độ kiểm chứng trung thực (0 cũng hiện).
import Icon from './icons/Icon.astro';
import { chapterGroups, loadStatus, verifiedCount, reviewCount, url, type Chapter, type Entry } from '../lib/site';
interface Props { chapters: Chapter[]; entries: Entry[]; headingLevel?: 2 | 3; jump?: boolean; }
const { chapters, entries, headingLevel = 3, jump = true } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
const status = loadStatus(entries);
const byNum = new Map(chapters.map((c) => [c.data.number, c]));
const groups = chapterGroups(chapters.map((c) => c.data.number));
const total = (n: number) => status.chapters.get(n)?.total ?? entries.filter((e) => e.data.chapter === n).length;
---
{jump && (
  <nav class="group-jump" aria-label="Chọn nhóm chủ đề">
    <ul>
      {groups.map((g) => <li><a href={`#nhom-${g.slug}`}><Icon name={g.icon as any} size={16} />{g.title}</a></li>)}
    </ul>
  </nav>
)}
<div class="chapter-groups">
  {groups.map((g) => (
    <section class="cgroup" id={`nhom-${g.slug}`} aria-labelledby={`nhom-${g.slug}-h`}>
      <header class="cgroup__head">
        <span class="cgroup__ico"><Icon name={g.icon as any} size={22} /></span>
        <div>
          <H class="cgroup__title" id={`nhom-${g.slug}-h`}>{g.title}</H>
          <p class="cgroup__desc">{g.description}</p>
        </div>
      </header>
      <ul class="cgroup__list">
        {g.chapters.map((n) => {
          const c = byNum.get(n)!;
          const row = status.chapters.get(n);
          const t = total(n);
          const ok = verifiedCount(row);
          const rv = reviewCount(row);
          return (
            <li class="ccard">
              <a class="ccard__link" href={url.chapter(n)}>
                <span class="ccard__n">Chương {n}</span>
                <span class="ccard__title">{c.data.title}</span>
                <span class="ccard__meta">
                  <span>{t} mục</span>
                  <span class="ccard__prog" title="Số mục đã đối chiếu nguồn trở lên trên tổng số mục của chương">
                    <span class="ccard__bar" aria-hidden="true"><span style={`width:${t ? Math.round((ok / t) * 100) : 0}%`}></span></span>
                    {ok}/{t} đã kiểm chứng
                  </span>
                  {rv > 0 && <span class="ccard__rv"><Icon name="shield-alert" size={13} />{rv} đang rà soát</span>}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</div>
