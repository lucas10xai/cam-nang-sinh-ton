---
import Icon from './icons/Icon.astro';
import type { IconName } from './icons/paths';
interface Props { summary: string; open?: boolean; class?: string; id?: string; icon?: string; }
const { summary, open = false, class: cls, id, icon } = Astro.props;
---
<details class:list={['accordion', cls]} open={open} id={id}>
  <summary>{icon && <Icon name={icon as IconName} size={18} class="accordion__ico" />}<span class="accordion__t">{summary}</span><Icon name="chevron-down" size={18} class="accordion__caret" /></summary>
  <div class="accordion__body"><slot /></div>
</details>
