---
// Dải số khẩn cấp một dòng, mọi số là liên kết tel:.
import { loadHotlines, hotlineShort } from '../lib/site';
interface Props { lead?: string; class?: string; }
const { lead = 'Gọi khẩn cấp', class: cls } = Astro.props;
const { items } = loadHotlines();
---
<p class:list={['hotline-strip', cls]}>
  <span class="hotline-strip__lead">{lead}:</span>
  {items.map((h, i) => (
    <>{i > 0 && <span class="hotline-strip__sep" aria-hidden="true">·</span>}<a href={`tel:${h.number}`} aria-label={`Gọi ${h.number}, ${h.label}`}><b>{h.number}</b> {hotlineShort(h)}</a></>
  ))}
</p>
