---
import '../styles/global.css';
import Icon from '../components/icons/Icon.astro';
import { SITE_NAME, DISCLAIMER, NOTICE_LEAD, NOTICE_MORE, REPO_URL, ISSUES_URL, SITE_INDEXABLE, url } from '../lib/site';
interface Props { title?: string; description?: string; wide?: boolean; noindex?: boolean; }
const { title, description = 'Cẩm nang việc nên làm để sống lâu hơn, đỡ tốn hơn, ít vướng luật hơn, biên soạn theo bối cảnh Việt Nam.', wide = false, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME}: việc nên làm, theo luật và bối cảnh Việt Nam`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const robots = SITE_INDEXABLE && !noindex ? null : SITE_INDEXABLE ? 'noindex' : 'noindex,nofollow';
const nav = [
  { href: '/chuong/', label: 'Chương' },
  { href: '/tinh-huong/', label: 'Tình huống' },
  { href: '/tra-cuu/', label: 'Tra cứu' },
  { href: '/viec-cua-toi/', label: 'Việc của tôi' },
  { href: '/phuong-phap/', label: 'Phương pháp' },
  { href: '/gioi-thieu/', label: 'Giới thiệu' },
];
const path = Astro.url.pathname;
const active = (href: string) => path.startsWith(url(href));
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={url('/fonts/be-vietnam-pro-Regular.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('/fonts/noto-serif-vi.woff2')} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f6f1e6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1812" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="vi_VN" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('cnst:theme');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#noi-dung">Bỏ qua, tới nội dung</a>
    <div class="notice" role="note">
      <div class="container notice__in"><Icon name="info" size={14} /><p>{NOTICE_LEAD}<span class="notice__more"> {NOTICE_MORE}</span> <a href={url('/phuong-phap/')}>Tìm hiểu thêm</a></p></div>
    </div>
    <header class="site-header" id="site-header">
      <div class="container site-header__in">
        <a class="brand" href={url('/')} aria-label={`${SITE_NAME}, về trang chủ`}>
          <svg class="brand__mark" width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><use href={url('/icons.svg#brand')} /></svg>
          <span class="brand__name">{SITE_NAME}</span>
        </a>
        <button class="icon-btn nav-toggle" type="button" id="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Mở menu">
          <span class="nav-toggle__open"><Icon name="menu" size={21} /></span>
          <span class="nav-toggle__close"><Icon name="x" size={21} /></span>
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Chính">
          <ul>
            {nav.map((n) => (
              <li><a href={url(n.href)} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="site-header__actions">
          <a class="icon-btn" href={url('/tim-kiem/')} aria-label="Tìm kiếm"><Icon name="search" size={19} /></a>
          <button class="icon-btn" type="button" id="theme-toggle" aria-label="Đổi giao diện sáng, tối">
            <span class="theme-ico theme-ico--sun"><Icon name="sun" size={19} /></span>
            <span class="theme-ico theme-ico--moon"><Icon name="moon" size={19} /></span>
          </button>
        </div>
      </div>
    </header>
    <main id="noi-dung" class:list={['container', { 'container--wide': wide }]} tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__grid">
          <div class="site-footer__about">
            <a class="brand brand--footer" href={url('/')}>
              <svg class="brand__mark" width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><use href={url('/icons.svg#brand')} /></svg>
              <span class="brand__name">{SITE_NAME}</span>
            </a>
            <p>Sổ tay việc nên làm để sống khỏe hơn, đỡ tốn hơn và ít vướng luật hơn, theo bối cảnh Việt Nam. Không theo dõi người đọc, không quảng cáo, không tài khoản.</p>
          </div>
          <nav aria-label="Đọc">
            <h2 class="site-footer__h">Đọc</h2>
            <ul>
              <li><a href={url('/chuong/')}>Các chương</a></li>
              <li><a href={url('/tinh-huong/')}>Theo tình huống</a></li>
              <li><a href={url('/tra-cuu/')}>Tra cứu và lọc</a></li>
              <li><a href={url('/viec-cua-toi/')}>Việc của tôi</a></li>
            </ul>
          </nav>
          <nav aria-label="Dự án">
            <h2 class="site-footer__h">Dự án</h2>
            <ul>
              <li><a href={url('/phuong-phap/')}>Phương pháp và kiểm chứng</a></li>
              <li><a href={url('/gioi-thieu/')}>Giới thiệu và ghi công</a></li>
              <li><a href={REPO_URL} rel="noopener noreferrer">Mã nguồn trên GitHub <Icon name="external-link" size={13} /></a></li>
              <li><a href={ISSUES_URL} rel="noopener noreferrer">Báo lỗi, góp ý <Icon name="external-link" size={13} /></a></li>
            </ul>
          </nav>
        </div>
        <div class="site-footer__legal">
          <p><strong>{DISCLAIMER}</strong> Luật, mức phạt và giá đổi theo thời gian: mỗi mục ghi rõ trạng thái kiểm chứng của chính nó.</p>
          <p>Biên soạn lại từ <em>高性价比人生指南</em> (eternity4719, CC BY 4.0) qua bản nháp tiếng Việt của quangpao, đối chiếu bản của luonglb; đã sửa cho bối cảnh Việt Nam. Nội dung theo giấy phép CC BY 4.0, mã nguồn theo giấy phép MIT. <a href={url('/gioi-thieu/')}>Ghi công đầy đủ</a>.</p>
        </div>
      </div>
    </footer>
    <script>import "../scripts/theme.ts";</script>
    <script>import "../scripts/nav.ts";</script>
  </body>
</html>
