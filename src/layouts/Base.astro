---
import '../styles/global.css';
import Icon from '../components/icons/Icon.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE_NAME, DISCLAIMER, REPO_URL, ISSUES_URL, SITE_INDEXABLE, loadAll, loadHotlines, hotlineShort, url } from '../lib/site';
interface Props { title?: string; description?: string; width?: 'default' | 'wide' | 'entry'; noindex?: boolean; /** Chương đang xem (tô sáng trong sidebar). */ chapter?: number; }
const { title, description = 'Cẩm nang việc nên làm để sống lâu hơn, đỡ tốn hơn, ít vướng luật hơn, biên soạn theo bối cảnh Việt Nam.', width = 'default', noindex = false, chapter } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME}: việc nên làm, theo luật và bối cảnh Việt Nam`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const robots = SITE_INDEXABLE && !noindex ? null : SITE_INDEXABLE ? 'noindex' : 'noindex,nofollow';
const { entries } = await loadAll();
const hot = loadHotlines().items;
const path = Astro.url.pathname;
const active = (href: string) => path.startsWith(url(href));
const nav = [
  { href: '/tra-cuu/', label: 'Tra cứu' },
  { href: '/viec-cua-toi/', label: 'Việc của tôi', counter: true },
  { href: '/phuong-phap/', label: 'Phương pháp' },
];
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={url('/fonts/inter-vi.woff2')} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0d" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('cnst:theme');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#noi-dung">Bỏ qua, tới nội dung</a>
    <header class="topbar" id="site-header">
      <div class="topbar__in">
        <button class="icon-btn menu-btn js-only" type="button" id="menu-toggle" aria-expanded="false" aria-controls="sidebar" aria-label="Mở danh mục"><span class="menu-ico--o"><Icon name="menu" size={18} /></span><span class="menu-ico--x"><Icon name="x" size={18} /></span></button>
        <a class="brand" href={url('/')} aria-label={`${SITE_NAME}, về trang chủ`}><Icon name="book-open" size={16} />{SITE_NAME}</a>
        <span class="topbar__space"></span>
        <a class="search-trigger" href={url('/tim-kiem/')} id="spot-open" aria-label="Tìm kiếm" aria-keyshortcuts="/ Control+K Meta+K">
          <Icon name="search" size={15} /><span>Tìm trong {entries.length} mục…</span><kbd aria-hidden="true">/</kbd>
        </a>
        <nav class="nav" aria-label="Chính">
          {nav.map((n) => (
            <a href={url(n.href)} aria-current={active(n.href) ? 'page' : undefined}>{n.label}{n.counter && <span class="nav__count js-only" id="todo-count" hidden></span>}</a>
          ))}
        </nav>
        <details class="sos" data-pop>
          <summary aria-label={`Khẩn cấp: ${hot.map((h) => h.number).join(', ')}`}><i class="sos__dot" aria-hidden="true"></i>{hot[0]?.number ?? '115'}<span class="sos__t">Khẩn cấp</span></summary>
          <div class="popover">
            <ul class="sos__list">
              {hot.map((h) => (
                <li><a href={`tel:${h.number}`}><span class="sos__num">{h.number}</span><span class="sos__lab">{h.label}</span></a></li>
              ))}
            </ul>
            <p class="sos__note">Số chưa được kiểm chứng độc lập với cơ quan nhà nước; gọi không được thì tra lại số chính thức của địa phương.</p>
          </div>
        </details>
        <button class="icon-btn theme-btn js-only" type="button" data-theme-toggle aria-label="Đổi giao diện sáng, tối">
          <span class="theme-ico theme-ico--sun"><Icon name="sun" size={16} /></span>
          <span class="theme-ico theme-ico--moon"><Icon name="moon" size={16} /></span>
        </button>
      </div>
    </header>

    <div class="scrim" id="scrim"></div>
    <div class="layout">
      <Sidebar path={path} chapter={chapter} />
      <div class="main-col">
        <main id="noi-dung" class="content" tabindex="-1">
          <div class:list={['page', { 'page--wide': width === 'wide', 'page--entry': width === 'entry' }]}>
            <slot />
          </div>
        </main>
        <footer class="site-footer">
          <div class="site-footer__in">
            <p><strong>{DISCLAIMER}</strong> Luật, mức phạt và giá đổi theo thời gian: mỗi mục ghi rõ trạng thái kiểm chứng của chính nó.</p>
            <p>Biên soạn lại từ <em>高性价比人生指南</em> (eternity4719, CC BY 4.0) qua bản nháp tiếng Việt của quangpao, đối chiếu bản của luonglb; đã sửa cho bối cảnh Việt Nam. Nội dung theo giấy phép CC BY 4.0, mã nguồn theo giấy phép MIT. Không theo dõi, không quảng cáo, không tài khoản.</p>
            <div class="site-footer__links">
              <a href={url('/gioi-thieu/')}>Giới thiệu và ghi công</a>
              <a href={url('/phuong-phap/')}>Phương pháp</a>
              <a href={REPO_URL} rel="noopener noreferrer">Mã nguồn</a>
              <a href={ISSUES_URL} rel="noopener noreferrer">Báo lỗi, góp ý</a>
            </div>
          </div>
        </footer>
      </div>
    </div>

    <dialog class="spot js-only" id="spot" aria-label="Tìm kiếm trong cẩm nang">
      <div class="spot__box">
        <div class="spot__bar">
          <Icon name="search" size={17} />
          <input id="spot-q" type="search" role="combobox" aria-expanded="false" aria-controls="spot-list" aria-autocomplete="list" placeholder={`Tìm trong ${entries.length} mục…`} autocomplete="off" spellcheck="false" aria-label="Từ khóa (gõ không dấu cũng được)" />
          <kbd aria-hidden="true">Esc</kbd>
        </div>
        <ul class="spot__list" id="spot-list" role="listbox" aria-label="Kết quả" hidden></ul>
        <p class="spot__empty" id="spot-status" role="status" aria-live="polite">Gõ để tìm. Gõ không dấu cũng được: “lam them gio” ra “làm thêm giờ”.</p>
        <div class="spot__foot">
          <span class="spot__keys"><kbd>↑</kbd><kbd>↓</kbd> chọn</span>
          <span class="spot__keys"><kbd>Enter</kbd> mở</span>
          <a class="spot__all" id="spot-all" href={url('/tim-kiem/')}>Xem tất cả kết quả →</a>
        </div>
      </div>
    </dialog>

    <script>import "../scripts/theme.ts";</script>
    <script>import "../scripts/shell.ts";</script>
    <script>import "../scripts/spotlight.ts";</script>
    <script>import "../scripts/pop.ts";</script>
  </body>
</html>
