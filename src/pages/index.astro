---
import Base from '../layouts/Base.astro';
import Icon from '../components/icons/Icon.astro';
import EntryRow from '../components/EntryRow.astro';
import HotlineStrip from '../components/HotlineStrip.astro';
import ChapterIndex from '../components/ChapterIndex.astro';
import { loadAll, loadStatus, verifiedCount, worthOf, reviewKind, SITUATIONS, situationIcon, url } from '../lib/site';
import type { IconName } from '../components/icons/paths';
const { chapters, entries } = await loadAll();
const status = loadStatus(entries);
const verified = verifiedCount(status.totals);
const experts = status.totals.by_status['expert-reviewed'] ?? 0;
const sits = SITUATIONS
  .map((s) => ({ ...s, n: entries.filter((e) => e.data.situations.includes(s.slug)).length }))
  .filter((s) => s.n > 0);
// Việc làm ngay: lợi ích lớn, gần như không tốn gì. Ưu tiên mục đã soạn lại và không đang rà soát; thiếu thì lấy thêm mục chưa soạn lại (vẫn không đang rà soát).
const vh = entries.filter((e) => worthOf(e.data) === 'very-high' && !reviewKind(e.data.verification.status));
const quick = [...vh.filter((e) => e.data.rewrite_status === 'rewritten'), ...vh.filter((e) => e.data.rewrite_status !== 'rewritten')].slice(0, 6);
---
<Base>
  <header class="intro">
    <h1>Cẩm nang sinh tồn</h1>
    <p class="intro__lead">{entries.length} việc nên làm để giữ mạng, giữ tiền và tránh vướng luật theo bối cảnh Việt Nam. Mỗi mục tính rõ chi phí bỏ ra, lợi ích nhận lại và nguồn đối chiếu.</p>
    <p class="intro__trust"><Icon name="info" size={14} /><span>Mã nguồn mở công ích · {experts > 0 ? `${experts} mục có chuyên gia duyệt` : 'Chưa có chuyên gia duyệt'} (mới đối chiếu nguồn {verified}/{entries.length} mục) · Thông tin tham khảo, không thay bác sĩ hoặc luật sư. <a class="link" href={url('/phuong-phap/')}>Phương pháp →</a></span></p>
  </header>

  <section class="block" aria-labelledby="sit-h">
    <div class="block__head"><h2 id="sit-h">Đang gặp chuyện cần xử lý?</h2><a class="more" href={url('/tinh-huong/')}>Tất cả</a></div>
    <ul class="sit-grid">
      {sits.map((s) => (
        <li><a class="sit" href={`${url('/tinh-huong/')}#${s.slug}`}><Icon name={situationIcon(s.slug) as IconName} size={15} /><span class="sit__t">{s.title}</span><span class="sit__n">{s.n}<Icon name="arrow-right" size={13} /></span></a></li>
      ))}
    </ul>
    <HotlineStrip class="home-hot" />
  </section>

  {quick.length > 0 && (
    <section class="block" aria-labelledby="ln-h">
      <div class="block__head"><h2 id="ln-h">Bắt đầu nhanh: ít tốn kém, lợi ích lớn</h2></div>
      <div class="rows">
        {quick.map((e) => <EntryRow entry={e} brief />)}
      </div>
      <p class="block__foot"><a class="more" href={`${url('/tra-cuu/')}?worth=very-high`}>Lọc toàn bộ mục đáng làm cao →</a></p>
    </section>
  )}

  <section class="block" aria-labelledby="chuong-h">
    <div class="block__head"><h2 id="chuong-h">Mục lục {chapters.length} chương</h2><a class="more" href={url('/chuong/')}>Trang riêng</a></div>
    <ChapterIndex chapters={chapters} entries={entries} />
  </section>
</Base>
