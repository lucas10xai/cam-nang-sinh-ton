---
import Base from '../layouts/Base.astro';
import Icon from '../components/icons/Icon.astro';
import HotlineStrip from '../components/HotlineStrip.astro';
import { loadAll, SITE_NAME, SITE_TAGLINE, url } from '../lib/site';
const { chapters, entries } = await loadAll();
const counts = new Map<number, number>();
for (const e of entries) counts.set(e.data.chapter, (counts.get(e.data.chapter) ?? 0) + 1);
---
<Base>
  <section class="hero">
    <h1>{SITE_NAME}</h1>
    <p class="hero__lead">{SITE_TAGLINE} {entries.length} việc nhỏ, mỗi việc ghi rõ tốn gì và được gì.</p>
    <form class="searchbox" action="/tim-kiem/" method="get" role="search">
      <label class="visually-hidden" for="q">Tìm một việc, một điều luật hay một bệnh (gõ không dấu cũng được)</label>
      <input id="q" type="search" name="q" placeholder="Ví dụ: làm thêm giờ, bao hiem, đột quỵ" autocomplete="off" />
      <button class="btn" type="submit"><Icon name="search" size={18} />Tìm</button>
    </form>
    <ul class="quick-links">
      <li><a class="btn btn--ghost" href="/tra-cuu/"><Icon name="filter" size={16} />Lọc theo chi phí, bằng chứng</a></li>
      <li><a class="btn btn--ghost" href="/viec-cua-toi/"><Icon name="list-checks" size={16} />Việc của tôi</a></li>
    </ul>
  </section>

  <HotlineStrip />

  <section aria-labelledby="chuong-h">
    <div class="section-title">
      <h2 id="chuong-h">Đọc theo chương</h2>
      <a href="/chuong/">Tất cả chương <Icon name="arrow-right" size={14} /></a>
    </div>
    <ul class="grid grid--3">
      {chapters.map((c) => (
        <li class="card">
          <a class="chapter-link" href={url.chapter(c.data.number)}>
            <span class="chapter-link__n">Chương {c.data.number}</span>
            <h3>{c.data.title}</h3>
            <p class="chapter-link__c">{counts.get(c.data.number) ?? 0} mục</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="prose" aria-labelledby="doc-h">
    <h2 id="doc-h">Đọc thế nào cho đúng</h2>
    <p>Mỗi mục hiện ghi rõ mức kiểm chứng của chính nó. Phần lớn nội dung <strong>chưa có chuyên gia duyệt</strong>; hãy xem huy hiệu trạng thái đầu mỗi trang trước khi làm theo, nhất là chuyện luật và thuốc. <a href="/phuong-phap/">Xem phương pháp và tiến độ kiểm chứng</a>.</p>
  </section>
</Base>
