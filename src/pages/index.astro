---
import Base from '../layouts/Base.astro';
import Icon from '../components/icons/Icon.astro';
import HotlineStrip from '../components/HotlineStrip.astro';
import ChapterGroups from '../components/ChapterGroups.astro';
import { loadAll, loadStatus, verifiedCount, chapterGroups, SITE_TAGLINE, SITUATIONS, situationIcon, url } from '../lib/site';
const { chapters, entries } = await loadAll();
const status = loadStatus(entries);
const checked = verifiedCount(status.totals);
const expert = status.totals.by_status['expert-reviewed'] ?? 0;
const groupCount = chapterGroups(chapters.map((c) => c.data.number)).length;
// Chỉ hiện tình huống đã có mục (cùng cách làm với trang Tình huống).
const sits = SITUATIONS
  .map((s) => ({ ...s, n: entries.filter((e) => e.data.situations.includes(s.slug)).length }))
  .filter((s) => s.n > 0);
const suggestions = ['bị cho nghỉ việc', 'đau ngực', 'bị lừa chuyển tiền'];
---
<Base>
  <section class="hero" aria-labelledby="hero-h">
    <div class="hero__text">
      <p class="eyebrow">Sổ tay sống khỏe, giữ tiền, hiểu luật</p>
      <h1 id="hero-h">Biết việc gì nên làm, <em>trước khi</em> chuyện xảy ra.</h1>
      <p class="hero__lead">{SITE_TAGLINE} {entries.length} việc nhỏ, mỗi việc ghi rõ tốn gì và được gì.</p>
      <form class="searchbox searchbox--hero" action={url('/tim-kiem/')} method="get" role="search">
        <label class="visually-hidden" for="q">Tìm một việc, một điều luật hay một bệnh (gõ không dấu cũng được)</label>
        <span class="searchbox__ico"><Icon name="search" size={20} /></span>
        <input id="q" type="search" name="q" placeholder="Thử gõ: bị cho nghỉ việc, đau ngực…" autocomplete="off" />
        <button class="btn" type="submit">Tìm</button>
      </form>
      <p class="hero__try">
        <span>Hay gặp:</span>
        {suggestions.map((s) => <a class="pill" href={`${url('/tim-kiem/')}?q=${encodeURIComponent(s)}`}>{s}</a>)}
      </p>
    </div>
    <div class="hero__aside">
      <HotlineStrip compact />
    </div>
  </section>

  <section class="block" aria-labelledby="sit-h">
    <div class="section-head">
      <div>
        <h2 id="sit-h" class="section-head__t">Bạn đang gặp chuyện gì?</h2>
        <p class="section-head__s">Chọn tình huống gần nhất, chúng tôi gom sẵn các mục nên đọc.</p>
      </div>
      <a class="more-link" href={url('/tinh-huong/')}>Tất cả tình huống <Icon name="arrow-right" size={15} /></a>
    </div>
    <ul class="sit-grid">
      {sits.map((s) => (
        <li>
          <a class="sit-card" href={`${url('/tinh-huong/')}#${s.slug}`}>
            <span class="sit-card__ico"><Icon name={situationIcon(s.slug) as any} size={22} /></span>
            <span class="sit-card__t">{s.title}</span>
            <span class="sit-card__n">{s.n} mục <Icon name="arrow-right" size={13} /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="block" aria-labelledby="chuong-h">
    <div class="section-head">
      <div>
        <h2 id="chuong-h" class="section-head__t">Hoặc đọc theo chủ đề</h2>
        <p class="section-head__s">{chapters.length} chương, {entries.length} mục, gom thành {groupCount} nhóm. Mỗi chương ghi số mục đã được đối chiếu nguồn.</p>
      </div>
      <a class="more-link" href={url('/chuong/')}>Danh sách chương <Icon name="arrow-right" size={15} /></a>
    </div>
    <ChapterGroups chapters={chapters} entries={entries} />
  </section>

  <section class="honest" aria-labelledby="doc-h">
    <span class="honest__ico"><Icon name="shield-check" size={24} /></span>
    <div>
      <h2 id="doc-h">Đọc thế nào cho đúng</h2>
      <p>Mỗi mục có huy hiệu trạng thái kiểm chứng của chính nó. Hiện mới <strong>{checked}/{entries.length}</strong> mục được đối chiếu nguồn và <strong>{expert === 0 ? 'chưa mục nào có chuyên gia duyệt' : `${expert} mục có chuyên gia duyệt`}</strong>. Hãy xem huy hiệu trước khi làm theo, nhất là chuyện luật và thuốc.</p>
      <p><a class="more-link" href={url('/phuong-phap/')}>Xem phương pháp và tiến độ kiểm chứng <Icon name="arrow-right" size={15} /></a></p>
    </div>
  </section>
</Base>
