---
import Base from '../layouts/Base.astro';
import Icon from '../components/icons/Icon.astro';
import HotlineStrip from '../components/HotlineStrip.astro';
import { url } from '../lib/url';
---
<Base title="Không tìm thấy trang" noindex>
  <header class="head">
    <p class="head__code" aria-hidden="true">404</p>
    <h1>Không tìm thấy trang này</h1>
    <p class="head__lead">Đường dẫn có thể đã đổi hoặc gõ sai. Thử một trong các lối sau.</p>
  </header>
  <div class="actions">
    <a class="btn btn--primary" href={url('/')}><Icon name="home" size={14} />Tổng quan</a>
    <a class="btn" href={url('/tim-kiem/')}><Icon name="search" size={14} />Tìm kiếm</a>
    <a class="btn" href={url('/chuong/')}><Icon name="book-open" size={14} />Các chương</a>
    <a class="btn" href={url('/tinh-huong/')}><Icon name="compass" size={14} />Tình huống</a>
  </div>
  <HotlineStrip class="home-hot" />
</Base>
