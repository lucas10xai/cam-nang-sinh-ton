---
import Base from '../layouts/Base.astro';
import Icon from '../components/icons/Icon.astro';
import EntryCard from '../components/EntryCard.astro';
import Accordion from '../components/Accordion.astro';
import { loadAll, SITUATIONS, situationIcon, url } from '../lib/site';
import type { IconName } from '../components/icons/paths';
const { entries } = await loadAll();
// Chỉ liệt kê tình huống đã có mục; tình huống chưa có mục thì ẩn.
const groups = SITUATIONS
  .map((s) => ({ ...s, list: entries.filter((e) => e.data.situations.includes(s.slug)) }))
  .filter((g) => g.list.length > 0);
---
<Base title="Tình huống" description="Bạn đang gặp chuyện gì? Chọn tình huống để xem các mục liên quan.">
  <div class="page-head"><p class="eyebrow">Lối vào nhanh</p><h1>Bạn đang gặp chuyện gì?</h1><p>Bấm vào một tình huống để xem các mục nên đọc, xếp theo chương.</p></div>
  {groups.length === 0
    ? <p class="muted">Chưa có tình huống nào có mục. Hãy xem <a href={url('/chuong/')}>danh sách chương</a>.</p>
    : (
      <>
        <ul class="sit-grid sit-grid--jump">
          {groups.map((g) => (
            <li>
              <a class="sit-card" href={`#${g.slug}`}>
                <span class="sit-card__ico"><Icon name={situationIcon(g.slug) as IconName} size={22} /></span>
                <span class="sit-card__t">{g.title}</span>
                <span class="sit-card__n">{g.list.length} mục <Icon name="chevron-down" size={13} /></span>
              </a>
            </li>
          ))}
        </ul>
        <div class="sit-list">
          {groups.map((g) => (
            <Accordion class="sit" id={g.slug} summary={`${g.title} · ${g.list.length} mục`} icon={situationIcon(g.slug)}>
              <ul class="entry-list">{g.list.map((e) => <li><EntryCard entry={e} slim /></li>)}</ul>
            </Accordion>
          ))}
        </div>
      </>
    )}
  <script is:inline>
    (function () {
      function openHash() {
        var el = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (el && el.tagName === 'DETAILS') el.open = true;
      }
      openHash();
      addEventListener('hashchange', openHash);
    })();
  </script>
</Base>
