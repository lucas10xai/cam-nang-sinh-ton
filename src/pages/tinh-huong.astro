---
import Base from '../layouts/Base.astro';
import Icon from '../components/icons/Icon.astro';
import EntryRow from '../components/EntryRow.astro';
import HotlineStrip from '../components/HotlineStrip.astro';
import { loadAll, SITUATIONS, situationIcon, url } from '../lib/site';
import type { IconName } from '../components/icons/paths';
const { entries } = await loadAll();
// Chỉ liệt kê tình huống đã có mục; tình huống chưa có mục thì ẩn.
const groups = SITUATIONS
  .map((s) => ({ ...s, list: entries.filter((e) => e.data.situations.includes(s.slug)) }))
  .filter((g) => g.list.length > 0);
---
<Base title="Tình huống" description="Bạn đang gặp chuyện gì? Chọn tình huống để xem các mục liên quan.">
  <header class="head">
    <h1>Bạn đang gặp chuyện gì?</h1>
    <p class="head__lead">Bấm vào một tình huống để xem các mục nên đọc, xếp theo chương.</p>
  </header>
  <HotlineStrip class="home-hot" />
  {groups.length === 0
    ? <p class="muted">Chưa có tình huống nào có mục. Hãy xem <a class="link" href={url('/chuong/')}>danh sách chương</a>.</p>
    : (
      <div class="sit-list">
        {groups.map((g) => (
          <details class="fold-row" id={g.slug}>
            <summary><Icon name={situationIcon(g.slug) as IconName} size={15} /><span class="fold-row__t">{g.title}</span><span class="fold-row__n">{g.list.length}</span><Icon name="chevron-down" size={14} class="fold-row__caret" /></summary>
            <div class="rows">{g.list.map((e) => <EntryRow entry={e} lead={false} />)}</div>
          </details>
        ))}
      </div>
    )}
  <script is:inline>
    (function () {
      function openHash() {
        var el = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (el && el.tagName === 'DETAILS') { el.open = true; el.scrollIntoView(); }
      }
      openHash();
      addEventListener('hashchange', openHash);
    })();
  </script>
</Base>
