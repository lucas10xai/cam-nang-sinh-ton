---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/icons/Icon.astro';
import EntryMeta from '../../components/EntryMeta.astro';
import HotlineStrip from '../../components/HotlineStrip.astro';
import { loadAll, loadHotlines, fold, renderSections, entryCode, url, fmtDate, reviewKind, REVIEW_WARNINGS, emergencyNumber } from '../../lib/site';

export async function getStaticPaths() {
  const { entries } = await loadAll();
  return entries.map((e) => ({ params: { id: e.data.id } }));
}
const { chapters, entries, byId } = await loadAll();
const e = byId.get(Astro.params.id!)!;
const d = e.data;
const chapter = chapters.find((c) => c.data.number === d.chapter);
const sections = renderSections(e, byId);
const rewritten = d.rewrite_status === 'rewritten';
const review = reviewKind(d.verification.status);
const reviewText = review === 'medical' ? REVIEW_WARNINGS.medical(emergencyNumber()) : review === 'legal' ? REVIEW_WARNINGS.legal() : null;
const siblings = entries.filter((x) => x.data.chapter === d.chapter);
const idx = siblings.findIndex((x) => x.data.id === d.id);
const prev = siblings[idx - 1];
const next = siblings[idx + 1];
const related = d.related.map((id) => byId.get(id)).filter((x): x is NonNullable<typeof x> => !!x);
for (const id of d.related) if (!byId.has(id)) console.warn(`[related chết] ${d.id} -> ${id}`);
const emergency = loadHotlines().showOnChapters.includes(d.chapter);
const isLegal = (t: string) => t === 'Pháp luật Việt Nam';
const slug = (t: string) => 's-' + fold(t).replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const secId = (t: string) => (isLegal(t) ? 'phap-luat' : slug(t));
const showSteps = rewritten && d.steps.length > 0;
// Mục lục: theo đúng thứ tự xuất hiện trên trang.
const toc = [
  ...(showSteps ? [{ id: 'steps-h', label: 'Các bước làm' }] : []),
  ...sections.map((s) => ({ id: secId(s.title), label: isLegal(s.title) ? 'Căn cứ pháp luật' : s.title })),
];
const expert = d.verification.status === 'expert-reviewed';
// Pagefind bỏ dấu thanh/mũ nhưng KHÔNG gộp "đ" với "d". Thêm các từ có chữ đ ở dạng không dấu để gõ "dot quy" vẫn ra "đột quỵ".
const plain = `${d.title} ${sections.map((s) => s.html).join(' ')}`.replace(/<[^>]+>/g, ' ');
const dWords = [...new Set((plain.match(/[\p{L}\p{N}]*[đĐ][\p{L}\p{N}]*/gu) ?? []).map((w) => fold(w)))].join(' ');
---
<Base title={d.title} description={(rewritten ? d.tldr : null) ?? sections.find((s) => s.title === 'Nói dễ hiểu')?.html.replace(/<[^>]+>/g, '').slice(0, 200) ?? d.title} width="entry" chapter={d.chapter}>
  <article class="entry" data-pagefind-body data-pagefind-meta={`chuong:Chương ${d.chapter}`} data-entry-id={d.id}>
    <header class="entry-head">
      <p class="entry-head__crumb" data-pagefind-ignore><a href={url.chapter(d.chapter)}>Chương {d.chapter}</a> · Mục {d.number} / {siblings.length}</p>
      <h1 data-pagefind-meta="title" data-pagefind-weight="10">{d.title}</h1>
      <EntryMeta entry={e} />
      {!expert && <p class="entry-head__note" data-pagefind-ignore>Chưa có chuyên gia duyệt — thông tin tham khảo, không thay thế bác sĩ hoặc luật sư.</p>}
      <div class="mark-inline" data-pagefind-ignore>
        <button class="btn" type="button" data-mark="read" aria-pressed="false"><Icon name="eye" size={14} /><span>Đánh dấu đã đọc</span></button>
        <button class="btn" type="button" data-mark="done" aria-pressed="false"><Icon name="circle-check" size={14} /><span>Đánh dấu đã làm</span></button>
      </div>
    </header>

    <div class="entry-layout">
      <div class="entry-main">
        {reviewText && (
          <div class="review-warn" role="alert" data-pagefind-ignore><Icon name="shield-alert" size={16} /><p>{reviewText}</p></div>
        )}
        {emergency && <div data-pagefind-ignore><HotlineStrip lead="Gọi ngay" class="entry-hot" /></div>}

        {rewritten && d.tldr && (
          <aside class="tldr" aria-labelledby="tldr-h"><h2 id="tldr-h">Kết luận ngắn</h2><p>{d.tldr}</p></aside>
        )}

        <div class="entry-body">
          {showSteps && (
            <section class="steps-box" aria-labelledby="steps-h">
              <h2 id="steps-h">Các bước làm</h2>
              <ol class={review ? 'steps steps--numbered' : 'steps'}>
                {d.steps.map((t, i) => (
                  review
                    ? <li><div class="step"><span class="step__text">{t}</span></div></li>
                    : <li><label class="step"><input type="checkbox" data-step={i} /><span class="step__text">{t}</span></label></li>
                ))}
              </ol>
              {!review && <p class="steps-count js-only" id="steps-count" role="status" data-pagefind-ignore></p>}
            </section>
          )}
          {sections.map((s) => {
            const id = secId(s.title);
            if (isLegal(s.title)) {
              return (
                <details class="legal-fold" id={id}>
                  <summary><Icon name="scale" size={15} /><span>Căn cứ pháp luật Việt Nam{d.legal_refs.length > 0 ? ` (${d.legal_refs.length} điều khoản)` : ''}</span><Icon name="chevron-down" size={14} class="legal-fold__caret" /></summary>
                  <div class="legal-fold__body">
                    {d.legal_refs.length > 0 && (
                      <ul class="legal-refs">
                        {d.legal_refs.map((r) => (
                          <li>
                            <span class="legal-refs__doc">{r.doc}{r.article ? `, ${r.article}` : ''}</span>
                            <div class="legal-refs__meta">
                              {r.effective_from && <>Có hiệu lực từ {fmtDate(r.effective_from)}. </>}
                              {r.checked_at && <>Đối chiếu ngày {fmtDate(r.checked_at)}. </>}
                              {r.url && <a class="link" href={r.url} rel="noopener noreferrer nofollow">Văn bản gốc <Icon name="external-link" size={12} /></a>}
                            </div>
                            {r.quote && <blockquote>{r.quote}</blockquote>}
                          </li>
                        ))}
                      </ul>
                    )}
                    <div class="prose"><Fragment set:html={s.html} /></div>
                  </div>
                </details>
              );
            }
            if (s.title === 'Nói dễ hiểu' && !(rewritten && d.tldr)) {
              return <section id={id} class="plain"><h2>Nói dễ hiểu</h2><div class="prose"><Fragment set:html={s.html} /></div></section>;
            }
            return <section id={id} class={s.title === 'Nguồn' ? 'sources' : undefined}><h2>{s.title}</h2><div class="prose"><Fragment set:html={s.html} /></div></section>;
          })}
        </div>
      </div>

      <aside class="entry-side" aria-label="Điều hướng trong trang" data-pagefind-ignore>
        <div class="entry-side__in">
          <nav class="side-toc" aria-labelledby="toc-h">
            <h2 id="toc-h" class="side-h">Trên trang này</h2>
            <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ol>
          </nav>
          <div class="mark-side">
            <button class="btn" type="button" data-mark="read" aria-pressed="false"><Icon name="eye" size={14} /><span>Đánh dấu đã đọc</span></button>
            <button class="btn" type="button" data-mark="done" aria-pressed="false"><Icon name="circle-check" size={14} /><span>Đánh dấu đã làm</span></button>
          </div>
          {related.length > 0 && (
            <section class="side-related" aria-labelledby="lq-h">
              <h2 id="lq-h" class="side-h">Mục liên quan</h2>
              <ul>
                {related.map((r) => <li><a href={url.entry(r.data.id)}><span class="num">{entryCode(r)}</span>{r.data.title}</a></li>)}
              </ul>
            </section>
          )}
        </div>
      </aside>
    </div>
    {dWords && <div hidden>{dWords}</div>}
  </article>

  {related.length > 0 && (
    <section class="related-end" aria-labelledby="lq-end-h" data-pagefind-ignore>
      <h2 id="lq-end-h" class="side-h">Mục liên quan</h2>
      <ul>
        {related.map((r) => <li><a href={url.entry(r.data.id)}><span class="num">{entryCode(r)}</span>{r.data.title}</a></li>)}
      </ul>
    </section>
  )}

  <nav class="pager" aria-label="Mục cùng chương" data-pagefind-ignore>
    {prev ? <a class="pager__a" href={url.entry(prev.data.id)}><small><Icon name="arrow-left" size={13} />Mục trước · {entryCode(prev)}</small><span>{prev.data.title}</span></a> : <span />}
    {next ? <a class="pager__a pager__a--next" href={url.entry(next.data.id)}><small>Mục tiếp theo · {entryCode(next)}<Icon name="arrow-right" size={13} /></small><span>{next.data.title}</span></a> : <span />}
  </nav>
  <script>import '../../scripts/entry-page.ts';</script>
</Base>
